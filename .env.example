# Public app configuration; never put secrets in EXPO_PUBLIC_*.
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787
EXPO_PUBLIC_NEON_AUTH_URL=
EXPO_PUBLIC_ACCOUNT_ORIGIN=http://127.0.0.1:8081
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
# Must exactly match Spotify dashboard. localhost is not accepted.
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=http://127.0.0.1:8081/spotify

# API only; a Neon Postgres branch with Managed Auth is required for live sync.
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
ALLOWED_ORIGIN=http://127.0.0.1:8081
PORT=8787
