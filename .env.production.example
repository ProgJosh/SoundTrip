# Optional public build settings for Cloudflare hosting.
# Local music and Spotify export import work with all values empty.
# Copy to .env.production for local deployment, or set these in Cloudflare Builds.
# Never put database credentials, OAuth tokens or client secrets here.
EXPO_PUBLIC_API_URL=
EXPO_PUBLIC_NEON_AUTH_URL=
EXPO_PUBLIC_ACCOUNT_ORIGIN=
EXPO_PUBLIC_SPOTIFY_CLIENT_ID=
EXPO_PUBLIC_SPOTIFY_REDIRECT_URI=
